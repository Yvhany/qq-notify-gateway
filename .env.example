# QQ 开放平台机器人凭证
QQ_APP_ID=
QQ_SECRET=

# 推送目标：c2c（单聊）或 group（群聊）
TARGET_TYPE=c2c
# 单聊填 user_openid，群聊填 group_openid（由 bootstrap Worker 抓取）
TARGET_OPENID=

# 可选项 ----
# LISTEN_ADDR=:8080          # API 口：仅 POST /notify（token 校验）
# UI_LISTEN_ADDR=:8081       # Web UI 口：页面/记录/日志/WS（反代登录保护）；置空禁用 UI
# QQ_SANDBOX=false
# QQ_API_BASE=https://api.sgroup.qq.com
# 入站校验 token 初始种子：留空则首次启动自动生成并持久化到数据卷 webui.json；
# 运行期请在 Web UI 系统配置页查看/重置（.env 值仅在数据卷被清空时才会重新作为种子）
# GATEWAY_TOKEN=
